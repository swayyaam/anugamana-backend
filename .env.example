# --- required ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- optional: Indic language support (Sarvam AI) ---------------------------
# Without this the pipeline runs English-only; every Sarvam call degrades to a
# defined fallback. Verify the contract after setting it:
#   python scripts/verify_sarvam.py
SARVAM_API_KEY=

# Cross-lingual strategy: translate | direct | both
# Which one is best is an empirical question — see eval/conditions.py (L1-L3).
MULTILINGUAL_STRATEGY=translate

# --- optional: deployment ---------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173
