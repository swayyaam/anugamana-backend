# Example environment variables for Anugamana backend
# Copy this file to `.env` and fill in the real secrets before running.

# Anthropic (Claude) API key — required for LLM responses
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Pinecone API key — required if you use the Pinecone vector index
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=anugamana

# Upstash Redis REST credentials — used for caching
UPSTASH_REDIS_REST_URL=https://<your-upstash-id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# CORS allowed origins (comma-separated). Defaults to http://localhost:5173 if unset.
# Example: ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# Optional: tune logging or server port if you override defaults elsewhere
# LOG_LEVEL=info
# PORT=8000
